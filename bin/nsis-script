#!/usr/bin/env python3
"""Print what an NSIS installer does without running it.

  nsis-script FILE [--strings]

7-Zip extracts the files of an NSIS installer but doesn't show its script, which is
the part that says what runs. This decompresses the header and prints each instruction
that touches the system, such as the files it extracts, the programs it runs and the
registry keys it writes. Jumps, comparisons and page logic are counted, not printed, so
this says what an installer can do and not when. --strings prints the string table too.

Reads NSIS 3 Unicode installers compressed with LZMA or deflate. ANSI installers and
bzip2 are refused, and the opcodes differ before NSIS 3.

Everything in the file is treated as untrusted. Strings are escaped before printing.
"""
import argparse
import lzma
import struct
import sys
import zlib
from collections import Counter

MAGIC = b"\xef\xbe\xad\xdeNullsoftInst"
FIRST_HEADER = 28
COMPRESSED_FLAG = 0x80000000
MAX_HEADER = 1 << 26
ENTRY_SIZE = 28
ENTRIES_BLOCK, STRINGS_BLOCK, LANGUAGE_BLOCK = 2, 3, 4
LANG_CODE, SHELL_CODE, VAR_CODE, SKIP_CODE = 1, 2, 3, 4
VARIABLES = {20: "$CMDLINE", 21: "$INSTDIR", 22: "$OUTDIR", 23: "$EXEDIR", 24: "$LANGUAGE", 25: "$TEMP", 26: "$PLUGINSDIR",
             27: "$EXEPATH", 28: "$EXEFILE", 29: "$HWNDPARENT", 30: "$_CLICK", 31: "$_OUTDIR"}
# Opcode names, with the parameters that hold strings. Anything else is only counted.
OPCODES = {1: ("Return", ()), 2: ("Nop", ()), 3: ("Abort", (0,)), 4: ("Quit", ()), 5: ("Call", ()), 6: ("DetailPrint", ()),
           7: ("Sleep", ()), 8: ("BringToFront", ()), 9: ("SetDetailsView", ()), 10: ("SetFileAttributes", (0,)),
           11: ("CreateDirectory", (0,)), 12: ("IfFileExists", (0,)), 13: ("SetFlag", ()), 14: ("IfFlag", ()), 15: ("GetFlag", ()),
           16: ("Rename", (0, 1)), 17: ("GetFullPathName", (1,)), 18: ("SearchPath", (1,)), 19: ("GetTempFileName", (1,)),
           20: ("ExtractFile", (1,)), 21: ("DeleteFile", (0,)), 22: ("MessageBox", (1,)), 23: ("RMDir", (0,)), 24: ("StrLen", ()),
           25: ("AssignVar", ()), 26: ("StrCmp", ()), 27: ("ReadEnvStr", (1,)), 28: ("IntCmp", ()), 29: ("IntOp", ()), 30: ("IntFmt", ()),
           31: ("PushPop", ()), 32: ("FindWindow", ()), 33: ("SendMessage", ()), 34: ("IsWindow", ()), 35: ("GetDlgItem", ()),
           36: ("SetCtlColors", ()), 37: ("SetBrandingImage", ()), 38: ("CreateFont", ()), 39: ("ShowWindow", ()),
           40: ("ExecShell", (1, 2, 3)), 41: ("Exec", (0,)), 42: ("GetFileTime", ()), 43: ("GetDllVersion", ()),
           44: ("RegisterDLL", (0, 1)), 45: ("CreateShortcut", (0, 1, 2)), 46: ("CopyFiles", (0, 1)), 47: ("Reboot", ()),
           48: ("WriteINI", (0, 1, 2, 3)), 49: ("ReadINI", (1, 2, 3)), 50: ("DeleteReg", (1, 2)), 51: ("WriteReg", (1, 2, 3)),
           52: ("ReadReg", (1, 2)), 53: ("EnumReg", (2,)), 54: ("FileClose", ()), 55: ("FileOpen", (3,)), 56: ("FileWrite", ()),
           57: ("FileRead", ()), 58: ("FileSeek", ()), 59: ("FindClose", ()), 60: ("FindNext", ()), 61: ("FindFirst", (2,)),
           62: ("WriteUninstaller", (0,)), 63: ("LogText", ()), 64: ("SectionSet", ()), 65: ("InstTypeSet", ()),
           66: ("GetLabelAddr", ()), 67: ("GetFunctionAddr", ()), 68: ("LockWindow", ()), 69: ("FileWriteUTF16", ()),
           70: ("FileReadUTF16", ())}
PRINTED = {3, 10, 11, 16, 17, 18, 20, 21, 23, 27, 40, 41, 44, 45, 46, 48, 50, 51, 55, 61, 62}


class NsisError(Exception):
    pass


def escape(text):
    """Keep strings from the file from reaching the terminal as control sequences."""
    return "".join(char if char == "\\" or char.isprintable() else f"\\u{ord(char):04x}" for char in text)


def lzma_stream(data, limit):
    if len(data) < 5:
        raise NsisError("LZMA stream is too short")
    props = data[0]
    if props >= 225:
        raise NsisError("not an LZMA stream")
    rest = props // 9
    size = max(struct.unpack_from("<I", data, 1)[0], 4096)
    decoder = lzma.LZMADecompressor(format=lzma.FORMAT_RAW, filters=[
        {"id": lzma.FILTER_LZMA1, "lc": props % 9, "lp": rest % 5, "pb": rest // 5, "dict_size": min(size, 1 << 28)}])
    return decoder.decompress(data[5:], max_length=limit)


def deflate_stream(data, limit):
    return zlib.decompressobj(-15).decompress(data, limit)


def decode(data, limit):
    """Try the supported methods, in the order NSIS installers tend to use them."""
    for method in (lzma_stream, deflate_stream):
        try:
            plain = method(data, limit)
        except (lzma.LZMAError, zlib.error, NsisError, ValueError):
            continue
        if len(plain) >= limit - 4:
            return plain
    raise NsisError("the header isn't LZMA or deflate, or it is corrupt")


def read_header(data):
    """Return the header block, from a stored, a compressed or a solid installer."""
    pos = data.find(MAGIC)
    if pos < 4:
        raise NsisError("no NSIS header found")
    start = pos - 4
    _, _, size = struct.unpack_from("<I16sI", data, start)
    if not 0 < size <= MAX_HEADER:
        raise NsisError("header size makes no sense")
    body = data[start + FIRST_HEADER:]
    word = struct.unpack_from("<I", body, 0)[0] if len(body) >= 4 else 0
    if word == size:
        return body[4:4 + size]
    # The first bytes of a solid LZMA stream, 5d 00 00 80, also read as the compressed flag, so
    # that flag can't tell the two apart and each layout has to be tried.
    if word & COMPRESSED_FLAG and (word & ~COMPRESSED_FLAG) <= len(body) - 4:
        try:
            return decode(body[4:4 + (word & ~COMPRESSED_FLAG)], size)
        except NsisError:
            pass
    # A solid installer compresses everything as one stream, with the size in front of the header.
    plain = decode(body, size + 4)
    if struct.unpack_from("<I", plain, 0)[0] != size:
        raise NsisError("the header size inside the stream doesn't match")
    return plain[4:]


class Script:
    def __init__(self, header):
        self.header = header
        if len(header) < 4 + 8 * 8:
            raise NsisError("header is too short")
        blocks = [struct.unpack_from("<II", header, 4 + index * 8) for index in range(8)]
        self.entries_offset, self.entries_count = blocks[ENTRIES_BLOCK]
        strings_offset, _ = blocks[STRINGS_BLOCK]
        language_offset, _ = blocks[LANGUAGE_BLOCK]
        if not strings_offset <= language_offset <= len(header):
            raise NsisError("string table is out of place")
        if self.entries_offset + self.entries_count * ENTRY_SIZE > len(header):
            raise NsisError("entries run past the end of the header")
        self.table = header[strings_offset:language_offset]
        if self.table[:2] != b"\0\0":
            raise NsisError("this is an ANSI installer, only Unicode ones can be read")

    def string(self, offset):
        """Decode the string at a character offset, with variables spelled out."""
        pos = offset * 2
        if offset < 0 or pos >= len(self.table):
            return ""
        out = []
        while pos + 2 <= len(self.table):
            unit = struct.unpack_from("<H", self.table, pos)[0]
            pos += 2
            if unit == 0:
                break
            if unit > SKIP_CODE or pos + 2 > len(self.table):
                out.append(chr(unit))
                continue
            value = struct.unpack_from("<H", self.table, pos)[0]
            pos += 2
            # The value is split in two runs of 7 bits, which keeps zero bytes out of the table.
            number = (value & 0x7F) | ((value >> 8) & 0x7F) << 7
            if unit == VAR_CODE:
                name = VARIABLES.get(number)
                if name is None:
                    name = f"${number}" if number < 10 else f"$R{number - 10}" if number < 20 else f"$var{number}"
                out.append(name)
            elif unit == SHELL_CODE:
                out.append(f"$SHELL({value:#x})")
            elif unit == LANG_CODE:
                out.append(f"$LANG({number})")
            else:
                out.append(chr(value))
        return "".join(out)

    def entries(self):
        for index in range(self.entries_count):
            yield struct.unpack_from("<7i", self.header, self.entries_offset + index * ENTRY_SIZE)

    def strings(self):
        pos = 1
        total = len(self.table) // 2
        while pos < total:
            text = self.string(pos)
            end = pos
            while end < total and self.table[end * 2:end * 2 + 2] != b"\0\0":
                end += 1
            if text:
                yield pos, text
            pos = end + 1


def main():
    parser = argparse.ArgumentParser(description="Print what an NSIS installer does without running it.")
    parser.add_argument("file")
    parser.add_argument("--strings", action="store_true", help="also print the string table")
    args = parser.parse_args()
    try:
        with open(args.file, "rb") as source:
            data = source.read()
        script = Script(read_header(data))
    except (NsisError, OSError, struct.error) as error:
        print(f"nsis-script: {error}", file=sys.stderr)
        return 2
    counts = Counter()
    for entry in script.entries():
        opcode = entry[0]
        name, fields = OPCODES.get(opcode, (f"op{opcode}", ()))
        counts[name] += 1
        if opcode in PRINTED:
            texts = [script.string(entry[1 + field]) for field in fields]
            print("\t".join([name] + [escape(text) for text in texts if text]))
    print()
    print("[Instructions]")
    for name, count in counts.most_common():
        print(f"{count}\t{name}")
    if args.strings:
        print()
        print("[Strings]")
        for offset, text in script.strings():
            print(f"{offset}\t{escape(text)}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
