#!/usr/bin/env python3
"""Read Inno Setup installers from version 6.0 to 7.1 without running them.

  inno-unpack info FILE
  inno-unpack list FILE
  inno-unpack actions FILE
  inno-unpack code FILE [--dump OUT]
  inno-unpack disasm FILE [--proc NAME]
  inno-unpack engine FILE OUT
  inno-unpack extract FILE DIR [--only GLOB]

Every command also takes --password.

`info` prints the format version, the application and how the data is stored.
`list` prints size, hash and destination of each file. `actions` prints what the
installer does besides copying files, which means the commands it runs, registry
and INI changes, deletions, shortcuts, DLLs it registers and files it fetches. `code`
lists the names and strings found in the compiled [Code] script. It scans the
bytecode instead of decompiling it, so it says what the script can call, not
when. `disasm` disassembles that script, with the full list of external functions
it can reach. `engine` writes the setup engine stored in the installer, the program
that actually runs, with the call filter undone so its CALL targets are real.
`extract` writes the embedded files under DIR and checks each one against the hash
stored in the installer, keeping only the ones that match.

--password decrypts formats 6.4 and newer. Older ones use ARC4 and need innoextract,
as does anything older than 6.0. The data has to be inside the EXE, so installers
that ship setup-1.bin next to it can't be extracted.

A modified build of Inno Setup is reported as such. Builds that keep the format of
6.4.2 but swap CRC32 for XXH32 are read in full. Their file digests are XXH128, so
checking them needs the xxhash module, and without it the files are written but
reported as not verified.

The standard library is enough for everything. PyCryptodome speeds up decryption,
which is too slow for large installers in plain Python.

Everything in an installer is treated as untrusted. Strings are escaped before
printing and destinations can't leave DIR.
"""
import argparse
import bz2
import fnmatch
import hashlib
import lzma
import mmap
import os
import re
import shutil
import struct
import sys
import tempfile
import zlib
from collections import namedtuple

try:
    import xxhash
except ImportError:
    xxhash = None
try:
    from Cryptodome.Cipher import ChaCha20 as FastChaCha20
except ImportError:
    try:
        from Crypto.Cipher import ChaCha20 as FastChaCha20
    except ImportError:
        FastChaCha20 = None

LDR_ID = b"rDlPtS\xcd\xe6\xd7\x7b\x0b\x2a"
SETUP_ID = re.compile(rb"Inno Setup Setup Data \(([0-9.]+)\)")
CHUNK_ID = b"zlb\x1a"
BLOCK_CHUNK = 4096
FILTER_BLOCK = 0x10000  # has to match the buffer Setup decompresses with
# The sizes in an installer are untrusted, so these limits don't depend on them. Blocks hold
# metadata and images. Real chunks do use windows of hundreds of MiB, so a lower dictionary
# limit would break them, and one over MAX_DICTIONARY fails with a data error.
MAX_BLOCK = 1 << 28
MAX_DICTIONARY = 1 << 31
COMPRESSION = ("stored", "zip", "bzip2", "lzma", "lzma2")
ENCRYPTION = ("none", "files", "full")
# HKA is HKEY_AUTO, which Setup turns into HKLM or HKCU depending on the install mode.
REGISTRY_ROOTS = {1: "HKA", 0x80000000: "HKCR", 0x80000001: "HKCU", 0x80000002: "HKLM", 0x80000003: "HKU",
                  0x80000005: "HKCC"}
REG_TYPES = ("none", "string", "expandstring", "dword", "binary", "multistring", "qword")
DELETE_TYPES = ("files", "filesandordirs", "dirifempty")
WINDOWS_DEVICES = {"CON", "PRN", "AUX", "NUL", "CONIN$", "CONOUT$"} | {
    f"{device}{suffix}" for device in ("COM", "LPT") for suffix in "0123456789\u00b9\u00b2\u00b3"}

# Each row comes from the packed records in Shared.Struct.pas of the release
# that introduced the ID. Fixed sizes leave out the strings, which are stored
# first with a length prefix. Releases that kept the format kept the ID, so
# 6.1.0 also covers 6.2, 6.7.0 covers up to 6.7.4 and 7.0.0.3 covers up to 7.1.0.
# 6.4.0 only appeared in a prerelease.
Layout = namedtuple("Layout", "header_strings header_fixed compress_offset language_strings language_fixed "
                              "component_fixed task_fixed file_strings file_ansi file_fixed icon_fixed "
                              "registry_fixed run_strings run_fixed location_fixed")
LAYOUTS = {
    "6.0.0": Layout(30, 167, 148, 6, 21, 42, 26, 10, 0, 43, 32, 29, 13, 27, 74),
    "6.1.0": Layout(30, 167, 148, 6, 21, 42, 26, 10, 0, 43, 48, 29, 13, 27, 74),
    "6.3.0": Layout(32, 166, 148, 6, 21, 42, 26, 10, 0, 43, 48, 29, 13, 27, 75),
    "6.4.0": Layout(32, 177, 160, 6, 21, 42, 26, 10, 0, 43, 48, 29, 13, 27, 87),
    "6.4.0.1": Layout(32, 177, 160, 6, 21, 42, 26, 10, 0, 43, 48, 29, 13, 27, 87),
    "6.4.2": Layout(33, 177, 160, 6, 21, 42, 26, 10, 0, 43, 48, 29, 13, 27, 87),
    "6.4.3": Layout(33, 177, 160, 6, 21, 42, 26, 10, 0, 43, 48, 29, 13, 27, 85),
    "6.5.0": Layout(34, 133, 116, 6, 21, 42, 26, 15, 1, 77, 48, 29, 13, 27, 85),
    "6.5.2": Layout(34, 141, 124, 6, 21, 42, 26, 15, 1, 77, 48, 29, 13, 27, 89),
    "6.6.0": Layout(34, 149, 132, 4, 19, 42, 26, 15, 1, 77, 48, 29, 13, 27, 89),
    "6.6.1": Layout(34, 150, 133, 4, 19, 42, 26, 15, 1, 77, 48, 29, 13, 27, 89),
    "6.7.0": Layout(39, 162, 143, 4, 19, 39, 23, 15, 1, 80, 48, 29, 13, 27, 89),
    "7.0.0.1": Layout(39, 162, 143, 4, 19, 39, 23, 15, 1, 80, 48, 29, 14, 27, 89),
    "7.0.0.3": Layout(39, 166, 147, 4, 19, 39, 23, 15, 1, 81, 48, 30, 14, 28, 89),
    "7.1.1": Layout(38, 166, 147, 4, 19, 39, 23, 15, 1, 81, 48, 30, 14, 28, 89),
}
HEADER_ANSI = 4

# A fork of 6.4.2, recognized by its XXH32 checksums. The KDF salt grows from 16 to 64
# bytes, which adds 48 to the header, and the digest shrinks from 32 to 16 bytes. Its
# compression enum is also reordered. FastLZMA2 hasn't been seen in a real file, but
# that encoder writes plain LZMA2.
MODIFIED_LAYOUTS = {"6.4.2": LAYOUTS["6.4.2"]._replace(header_fixed=225, compress_offset=208, location_fixed=71)}
MODIFIED_COMPRESSION = ("lzma2", "lzma", "lzma2", "zip", "bzip2", "stored")
# Where 6.4 keeps PasswordTest in the header, before the salt, iterations and nonce.
HEADER_PASSWORD_TEST = 94
ENCRYPTED_FROM = (6, 4)
# SpecialFirstSlice of each TSpecialCryptContextType.
SLICE_PASSWORD_TEST, SLICE_BLOCK_SETUP, SLICE_BLOCK_LOCATIONS = -1, -2, -3

# Strings the tool reads, by position in the record.
APP_NAME, APP_VER_NAME, APP_ID, APP_PUBLISHER, APP_VERSION = 0, 1, 2, 4, 9
LICENSE, CODE = 0, 3
FILE_SOURCE, FILE_DEST, FILE_COMPONENTS, FILE_TASKS, FILE_LANGUAGES, FILE_CHECK = 0, 1, 4, 5, 6, 7
RUN_NAME, RUN_PARAMS, RUN_DIR, RUN_VERB, RUN_COMPONENTS, RUN_TASKS, RUN_LANGUAGES, RUN_CHECK = 0, 1, 2, 5, 7, 8, 9, 10
REG_SUBKEY, REG_VALUE_NAME, REG_VALUE_DATA, REG_COMPONENTS, REG_TASKS, REG_LANGUAGES, REG_CHECK = 0, 1, 2, 3, 4, 5, 6
RUN_SHELLEXEC, RUN_POSTINSTALL, RUN_NOWAIT = 1, 4, 1
FILE_REGSERVER, FILE_UNINSTALLER = 1 << 4, 1


class InnoError(Exception):
    pass


class Reader:
    def __init__(self, data):
        self.data = data
        self.pos = 0

    def take(self, n):
        if n < 0 or self.pos + n > len(self.data):
            raise InnoError(f"read of {n} bytes at {self.pos} runs past the end, the layout doesn't fit this file")
        chunk = self.data[self.pos:self.pos + n]
        self.pos += n
        return chunk

    def u8(self):
        return self.take(1)[0]

    def u32(self):
        return struct.unpack("<I", self.take(4))[0]

    def i32(self):
        return struct.unpack("<i", self.take(4))[0]

    def text(self):
        raw = self.take(self.u32())
        if len(raw) % 2:
            raise InnoError(f"odd UTF-16 length before {self.pos}, the layout doesn't fit this file")
        return raw.decode("utf-16-le", "replace")

    def blob(self):
        return self.take(self.u32())


Entry = namedtuple("Entry", "strings ansi fixed")
Location = namedtuple("Location", "index first_slice last_slice start_offset chunk_suboffset size compressed_size "
                                  "digest hash_name call_filter encrypted compressed")


def read_entries(reader, count, strings, ansi, fixed):
    entries = []
    for _ in range(count):
        texts = [reader.text() for _ in range(strings)]
        blobs = [reader.blob() for _ in range(ansi)]
        entries.append(Entry(texts, blobs, reader.take(fixed)))
    return entries


def xxh32(data, seed=0):
    """XXH32 of data, for builds that replace CRC32 with it."""
    if xxhash:
        return xxhash.xxh32_intdigest(bytes(data), seed)
    mask = 0xFFFFFFFF
    prime1, prime2, prime3, prime4, prime5 = 2654435761, 2246822519, 3266489917, 668265263, 374761393

    def rotate(value, bits):
        return (value << bits | value >> (32 - bits)) & mask

    length = len(data)
    pos = 0
    if length >= 16:
        lanes = [(seed + prime1 + prime2) & mask, (seed + prime2) & mask, seed & mask, (seed - prime1) & mask]
        for pos in range(0, length - length % 16, 16):
            for index, word in enumerate(struct.unpack_from("<4I", data, pos)):
                lanes[index] = rotate((lanes[index] + word * prime2) & mask, 13) * prime1 & mask
        pos = length - length % 16
        result = (rotate(lanes[0], 1) + rotate(lanes[1], 7) + rotate(lanes[2], 12) + rotate(lanes[3], 18)) & mask
    else:
        result = (seed + prime5) & mask
    result = (result + length) & mask
    while pos + 4 <= length:
        result = rotate((result + struct.unpack_from("<I", data, pos)[0] * prime3) & mask, 17) * prime4 & mask
        pos += 4
    while pos < length:
        result = rotate((result + data[pos] * prime5) & mask, 11) * prime1 & mask
        pos += 1
    result = (result ^ result >> 15) * prime2 & mask
    result = (result ^ result >> 13) * prime3 & mask
    return result ^ result >> 16


CHACHA_CONSTANTS = (0x61707865, 0x3320646E, 0x79622D32, 0x6B206574)
CHACHA_ROUNDS = ((0, 4, 8, 12), (1, 5, 9, 13), (2, 6, 10, 14), (3, 7, 11, 15),
                 (0, 5, 10, 15), (1, 6, 11, 12), (2, 7, 8, 13), (3, 4, 9, 14))


def chacha_core(state):
    """Run the 20 rounds of ChaCha on 16 words, without the final addition."""
    mask = 0xFFFFFFFF
    x = list(state)
    for _ in range(10):
        for a, b, c, d in CHACHA_ROUNDS:
            x[a] = (x[a] + x[b]) & mask
            value = x[d] ^ x[a]
            x[d] = (value << 16 | value >> 16) & mask
            x[c] = (x[c] + x[d]) & mask
            value = x[b] ^ x[c]
            x[b] = (value << 12 | value >> 20) & mask
            x[a] = (x[a] + x[b]) & mask
            value = x[d] ^ x[a]
            x[d] = (value << 8 | value >> 24) & mask
            x[c] = (x[c] + x[d]) & mask
            value = x[b] ^ x[c]
            x[b] = (value << 7 | value >> 25) & mask
    return x


class XChaCha20:
    """XChaCha20 in plain Python, for when PyCryptodome isn't installed."""

    def __init__(self, key, nonce):
        words = struct.unpack("<8I4I", key + nonce[:16])
        core = chacha_core(CHACHA_CONSTANTS + words)
        subkey = core[:4] + core[12:]
        self.state = list(CHACHA_CONSTANTS) + subkey + [0, 0] + list(struct.unpack("<2I", nonce[16:24]))
        self.buffer = b""

    def _block(self):
        words = [(word + start) & 0xFFFFFFFF for word, start in zip(chacha_core(self.state), self.state)]
        self.state[12] = (self.state[12] + 1) & 0xFFFFFFFF
        if not self.state[12]:
            self.state[13] = (self.state[13] + 1) & 0xFFFFFFFF
        return struct.pack("<16I", *words)

    def __call__(self, data):
        stream = bytearray(self.buffer)
        while len(stream) < len(data):
            stream += self._block()
        self.buffer = bytes(stream[len(data):])
        size = len(data)
        return (int.from_bytes(data, "little") ^ int.from_bytes(stream[:size], "little")).to_bytes(size, "little")


def xchacha20(key, nonce):
    """Return a function that decrypts the next bytes of an XChaCha20 stream."""
    return FastChaCha20.new(key=key, nonce=nonce).decrypt if FastChaCha20 else XChaCha20(key, nonce)


def nonce_for(base, start_offset, first_slice):
    """Recreate the nonce of a chunk or a block from the base nonce, as InitCryptContext does."""
    nonce = bytearray(base)
    struct.pack_into("<q", nonce, 0, struct.unpack_from("<q", nonce, 0)[0] ^ start_offset)
    struct.pack_into("<i", nonce, 8, struct.unpack_from("<i", nonce, 8)[0] ^ first_slice)
    return bytes(nonce)


Encryption = namedtuple("Encryption", "kdf salt iterations nonce test")


def derive_key(encryption, password):
    encoded = password.encode("utf-16-le", "surrogatepass")
    if encryption.kdf == "blake2b":
        # The fork passes Length(S) as the size, which counts characters, so only the first
        # half of the UTF-16 text is hashed. It also ignores the iterations.
        digest = hashlib.blake2b(encoded[:len(encoded) // 2], digest_size=64, key=encryption.salt).digest()
        return digest[16:48]
    return hashlib.pbkdf2_hmac("sha256", encoded, encryption.salt, encryption.iterations, 32)


def block_header(view, pos, checksum=zlib.crc32):
    """Return the header size, stored size and compression flag of the block at pos.

    Stored sizes went from 32 to 64 bits in 6.7. Both are tried because the CRC
    of the header tells them apart.
    """
    for size_format, end in (("<I", 9), ("<Q", 13)):
        raw = bytes(view[pos:pos + end])
        if len(raw) < end:
            continue
        crc = struct.unpack("<I", raw[:4])[0]
        if checksum(raw[4:]) == crc:
            return end, struct.unpack_from(size_format, raw, 4)[0], raw[end - 1]
    raise InnoError(f"no valid block header at {pos:#x}")


def lzma_filter(props, limit):
    """Filter for an LZMA1 stream. liblzma allocates the whole dictionary, so limit caps it."""
    lc = props[0] % 9
    rest = props[0] // 9
    dictionary = struct.unpack("<I", props[1:5])[0]
    return {"id": lzma.FILTER_LZMA1, "lc": lc, "lp": rest % 5, "pb": rest // 5,
            "dict_size": max(min(dictionary, limit), 4096)}


def read_block(view, pos, checksum=zlib.crc32, decrypt=None):
    """Read a compressed block, which is split in 4 KiB pieces that each carry a CRC.

    The CRCs cover the encrypted bytes, so decryption comes after them.
    """
    size_of_header, stored, compressed = block_header(view, pos, checksum)
    pos += size_of_header
    end = pos + stored
    if end > len(view):
        raise InnoError("block runs past the end of the file")
    data = bytearray()
    while pos < end:
        crc = struct.unpack("<I", bytes(view[pos:pos + 4]))[0]
        pos += 4
        piece = bytes(view[pos:min(pos + BLOCK_CHUNK, end)])
        if checksum(piece) != crc:
            raise InnoError(f"bad CRC in block data at {pos:#x}")
        data += decrypt(piece) if decrypt else piece
        pos += len(piece)
    if compressed:
        decompressor = lzma.LZMADecompressor(format=lzma.FORMAT_RAW,
                                             filters=[lzma_filter(data[:5], 1 << 30)])
        plain = decompressor.decompress(bytes(data[5:]), max_length=MAX_BLOCK + 1)
        if len(plain) > MAX_BLOCK:
            raise InnoError(f"block expands past {MAX_BLOCK} bytes")
        return plain, end
    return bytes(data), end


Table = namedtuple("Table", "offset0 offset1 engine_offset engine_size engine_check checksum")


def parse_table(raw):
    """Read a table of either version, or return None for one of another size or version."""
    version = struct.unpack_from("<I", raw, 12)[0]
    if version == 1 and len(raw) >= 44:
        engine_offset, engine_size, engine_check, offset0, offset1 = struct.unpack_from("<IIIII", raw, 20)
        return Table(offset0, offset1, engine_offset, engine_size, engine_check, None), 44
    if version == 2 and len(raw) >= 64:
        engine_offset, engine_size, engine_check, offset0, offset1 = struct.unpack_from("<QIIQQ", raw, 24)
        return Table(offset0, offset1, engine_offset, engine_size, engine_check, None), 64
    return None


def find_table(view):
    """Find the offset table of the loader and the checksum this build uses.

    The table lives in a PE resource, but the same ID is a constant in the loader
    code, so a hit only counts when the checksum of the table matches. A table that
    fails it yet points at setup data comes from a build that changed its checksum.
    """
    modified = None
    pos = view.find(LDR_ID)
    while pos >= 0:
        raw = bytes(view[pos:pos + 64])
        parsed = parse_table(raw) if len(raw) >= 16 else None
        if parsed:
            table, size = parsed
            stored = struct.unpack_from("<I", raw, size - 4)[0]
            for checksum in (zlib.crc32, xxh32):
                if checksum(raw[:size - 4]) == stored:
                    return table._replace(checksum=checksum)
            if SETUP_ID.match(bytes(view[table.offset0:table.offset0 + 64])):
                modified = pos
        pos = view.find(LDR_ID, pos + 1)
    if modified is not None:
        raise InnoError(f"the offset table at {modified:#x} points to setup data but its checksum is neither "
                        "CRC32 nor XXH32, so this is a modified build of Inno Setup")
    raise InnoError("no Inno Setup offset table found, this isn't an Inno Setup 5.1.5 or newer installer")


class Installer:
    def __init__(self, view, password=None):
        self.view = view
        self.table = find_table(view)
        self.offset0, self.offset1 = self.table.offset0, self.table.offset1
        self.checksum = self.table.checksum
        self.modified = self.checksum is xxh32
        raw_id = bytes(view[self.offset0:self.offset0 + 64])
        match = SETUP_ID.match(raw_id)
        if not match:
            raise InnoError(f"no setup data at {self.offset0:#x}, the installer may use a modified format")
        self.version = match.group(1).decode()
        if self.version not in LAYOUTS:
            known = tuple(int(part) for part in self.version.split("."))
            if known < (6,):
                raise InnoError(f"format {self.version} is older than 6.0, use innoextract")
            raise InnoError(f"format {self.version} isn't known, the newest here is 7.1.1")
        if self.modified and self.version not in MODIFIED_LAYOUTS:
            raise InnoError(f"modified build of format {self.version} isn't known, only "
                            f"{', '.join(MODIFIED_LAYOUTS)} can be read")
        self.layout = MODIFIED_LAYOUTS[self.version] if self.modified else LAYOUTS[self.version]
        self.encryption = "none"
        self.scheme = None
        self.key = None
        pos = self.offset0 + 64
        if self.layout.file_ansi:
            # The encryption header came in 6.5, together with the string that marks file_ansi.
            # It holds a CRC, the use of encryption, salt, iterations, nonce and password test.
            raw = bytes(view[pos:pos + 53])
            if self.checksum(raw[4:]) != struct.unpack("<I", raw[:4])[0]:
                raise InnoError("bad CRC in the encryption header")
            self.encryption = ENCRYPTION[raw[4]] if raw[4] < len(ENCRYPTION) else "unknown"
            self.scheme = Encryption("pbkdf2", raw[5:21], struct.unpack_from("<i", raw, 21)[0], raw[25:49], raw[49:53])
            pos += 53
        setup_cipher = locations_cipher = None
        if self.encryption == "full":
            if password is None:
                raise InnoError(f"format {self.version} with everything encrypted, nothing can be read "
                                "without --password")
            self._unlock(password)
            setup_cipher = self._special_cipher(SLICE_BLOCK_SETUP)
            locations_cipher = self._special_cipher(SLICE_BLOCK_LOCATIONS)
        self.setup0, pos = read_block(view, pos, self.checksum, setup_cipher)
        self.location_data, _ = read_block(view, pos, self.checksum, locations_cipher)
        self._parse()
        if not self.scheme and tuple(int(part) for part in self.version.split(".")) >= ENCRYPTED_FROM:
            self.scheme = self._header_scheme()
        if password is not None and self.encryption == "files":
            self._unlock(password)

    def _header_scheme(self):
        """Read the encryption fields that 6.4 keeps in the header."""
        fixed = self.header.fixed
        pos = HEADER_PASSWORD_TEST
        salt_size = 64 if self.modified else 16
        test = fixed[pos:pos + 4]
        salt = fixed[pos + 4:pos + 4 + salt_size]
        iterations = struct.unpack_from("<i", fixed, pos + 4 + salt_size)[0]
        nonce = fixed[pos + 8 + salt_size:pos + 32 + salt_size]
        return Encryption("blake2b" if self.modified else "pbkdf2", salt, iterations, nonce, test)

    def _special_cipher(self, first_slice):
        return xchacha20(self.key, nonce_for(self.scheme.nonce, 0, first_slice))

    def _unlock(self, password):
        if not self.scheme:
            raise InnoError(f"format {self.version} uses ARC4, decrypting it needs innoextract")
        if self.scheme.kdf == "pbkdf2" and not 1 <= self.scheme.iterations <= 1 << 24:
            raise InnoError(f"{self.scheme.iterations} KDF iterations make no sense, the layout doesn't fit this file")
        self.key = derive_key(self.scheme, password)
        if self._special_cipher(SLICE_PASSWORD_TEST)(bytes(4)) != self.scheme.test:
            self.key = None
            raise InnoError("wrong password")

    def chunk_cipher(self, first_slice, start_offset):
        """Return the decryption of a chunk. StartOffset was a signed 32 bits before 6.7."""
        if self.layout.location_fixed != 89 and start_offset >= 1 << 31:
            start_offset -= 1 << 32
        return xchacha20(self.key, nonce_for(self.scheme.nonce, start_offset, first_slice))

    def _parse(self):
        layout = self.layout
        reader = Reader(self.setup0)
        self.header = read_entries(reader, 1, layout.header_strings, HEADER_ANSI, layout.header_fixed)[0]
        has_issig = layout.file_ansi > 0
        counts = struct.unpack_from(f"<{17 if has_issig else 16}i", self.header.fixed)
        names = ["languages", "messages", "permissions", "types", "components", "tasks", "dirs"]
        names += ["issig", "files", "locations", "icons", "ini", "registry", "install_delete",
                  "uninstall_delete", "run", "uninstall_run"] if has_issig else \
                 ["files", "locations", "icons", "ini", "registry", "install_delete", "uninstall_delete",
                  "run", "uninstall_run"]
        self.counts = dict(zip(names, counts))
        if any(count < 0 or count > len(self.setup0) for count in self.counts.values()):
            raise InnoError("entry counts make no sense, the layout doesn't fit this file")
        method = self.header.fixed[layout.compress_offset]
        methods = MODIFIED_COMPRESSION if self.modified else COMPRESSION
        if method >= len(methods):
            raise InnoError("unknown compression method, the layout doesn't fit this file")
        self.compression = methods[method]
        self.languages = read_entries(reader, self.counts["languages"], layout.language_strings, 4, layout.language_fixed)
        read_entries(reader, self.counts["messages"], 2, 0, 4)
        read_entries(reader, self.counts["permissions"], 0, 1, 0)
        read_entries(reader, self.counts["types"], 4, 0, 30)
        read_entries(reader, self.counts["components"], 5, 0, layout.component_fixed)
        read_entries(reader, self.counts["tasks"], 6, 0, layout.task_fixed)
        read_entries(reader, self.counts["dirs"], 7, 0, 27)
        if has_issig:
            read_entries(reader, self.counts["issig"], 3, 0, 0)
        self.files = read_entries(reader, self.counts["files"], layout.file_strings, layout.file_ansi, layout.file_fixed)
        self.icons = read_entries(reader, self.counts["icons"], 13, 0, layout.icon_fixed)
        self.ini = read_entries(reader, self.counts["ini"], 10, 0, 21)
        self.registry = read_entries(reader, self.counts["registry"], 9, 0, layout.registry_fixed)
        self.install_delete = read_entries(reader, self.counts["install_delete"], 7, 0, 21)
        self.uninstall_delete = read_entries(reader, self.counts["uninstall_delete"], 7, 0, 21)
        self.run = read_entries(reader, self.counts["run"], layout.run_strings, 0, layout.run_fixed)
        self.uninstall_run = read_entries(reader, self.counts["uninstall_run"], layout.run_strings, 0, layout.run_fixed)
        images = struct.unpack("<i", reader.take(4))[0]
        if not -1 <= images <= 256:
            raise InnoError("no wizard images after the entries, the layout doesn't fit this file")
        self.locations = self._locations()

    def _locations(self):
        size = self.layout.location_fixed
        count = self.counts["locations"]
        if len(self.location_data) != count * size:
            raise InnoError(f"{len(self.location_data)} bytes of file locations for {count} entries of {size}, "
                            "the layout doesn't fit this file")
        wide_start = size == 89
        old_flags = size in (71, 74, 75, 87)
        digest_size, hash_name = {71: (16, "xxh128"), 74: (20, "sha1"), 75: (20, "sha1")}.get(size, (32, "sha256"))
        call_bit, encrypted_bit, compressed_bit = (4, 6, 7) if old_flags else (2, 3, 4)
        flags_size = 2 if old_flags else 1
        locations = []
        for index in range(count):
            raw = self.location_data[index * size:(index + 1) * size]
            first, last = struct.unpack_from("<ii", raw)
            pos = 8
            start = struct.unpack_from("<Q" if wide_start else "<I", raw, pos)[0]
            pos += 8 if wide_start else 4
            suboffset, length, compressed_size = struct.unpack_from("<qqq", raw, pos)
            if min(first, last, suboffset, length, compressed_size) < 0:
                raise InnoError(f"negative size or offset in file location {index}")
            pos += 24
            digest = raw[pos:pos + digest_size]
            if hash_name == "xxh128":
                digest = digest[::-1]  # stored as a little-endian number, printed the way xxhash does
            pos += digest_size + 16  # timestamp and file version
            flags = int.from_bytes(raw[pos:pos + flags_size], "little")
            locations.append(Location(index, first, last, start, suboffset, length, compressed_size, digest,
                                      hash_name, bool(flags >> call_bit & 1),
                                      bool(flags >> encrypted_bit & 1), bool(flags >> compressed_bit & 1)))
        if self.encryption == "none" and any(location.encrypted for location in locations):
            self.encryption = "files"
        return locations

    def file_location(self, entry):
        return struct.unpack_from("<i", entry.fixed, 33 * self.layout.file_ansi + 20)[0]

    def file_options(self, entry):
        offset = 33 * self.layout.file_ansi + 38
        return entry.fixed[offset + 1 if self.layout.file_fixed == 81 else offset]

    @property
    def code(self):
        return self.header.ansi[CODE]


class ChunkStream:
    """Decompress one chunk of file data on demand, which can be gigabytes when solid."""

    def __init__(self, view, location, method, total, decrypt=None):
        pos = location.start_offset
        if bytes(view[pos:pos + 4]) != CHUNK_ID:
            raise InnoError(f"no chunk at {pos:#x}")
        pos += 4
        self.view = view
        self.pos = pos
        self.end = pos + location.compressed_size
        if self.end > len(view):
            raise InnoError("chunk runs past the end of the file")
        self.decrypt = decrypt
        self.tail = b""
        self.method = method if location.compressed else "stored"
        limit = min(max(total, 1 << 16), MAX_DICTIONARY)
        if self.method == "lzma":
            props = self._input(5)
            self.decoder = lzma.LZMADecompressor(format=lzma.FORMAT_RAW, filters=[lzma_filter(props, limit)])
        elif self.method == "lzma2":
            prop = self._input(1)[0]
            dictionary = 0xFFFFFFFF if prop == 40 else (2 | (prop & 1)) << (prop // 2 + 11)
            self.decoder = lzma.LZMADecompressor(format=lzma.FORMAT_RAW, filters=[
                {"id": lzma.FILTER_LZMA2, "dict_size": max(min(dictionary, limit), 4096)}])
        elif self.method == "zip":
            self.decoder = zlib.decompressobj()
        elif self.method == "bzip2":
            self.decoder = bz2.BZ2Decompressor()

    def _input(self, size=1 << 20):
        piece = bytes(self.view[self.pos:min(self.pos + size, self.end)])
        self.pos += len(piece)
        return self.decrypt(piece) if self.decrypt else piece

    def read(self, size):
        out = bytearray()
        while len(out) < size:
            wanted = size - len(out)
            if self.method == "stored":
                piece = self._input(wanted)
                exhausted = not piece
            elif self.method == "zip":
                self.tail = self.tail or self._input()
                piece = self.decoder.decompress(self.tail, wanted)
                self.tail = self.decoder.unconsumed_tail
                exhausted = not piece and not self.tail and self.pos >= self.end
            else:
                feed = self._input() if self.decoder.needs_input and not self.decoder.eof else b""
                if self.decoder.eof:
                    piece = b""
                else:
                    piece = self.decoder.decompress(feed, wanted)
                exhausted = not piece and (self.decoder.eof or (self.decoder.needs_input and self.pos >= self.end))
            if exhausted:
                raise InnoError(f"chunk ended {wanted} bytes early")
            out += piece
        return out


CALL_OR_JMP = re.compile(rb"[\xe8\xe9]")


def undo_call_filter(buffer, address_offset):
    """Undo in place the filter that makes the operands of CALL and JMP absolute.

    Only the low 24 bits change. The high byte is flipped when bit 23 is set,
    and operands whose high byte isn't 00 or FF were left alone by the compiler.
    """
    limit = len(buffer) - 4
    position = 0
    while limit > 0:
        match = CALL_OR_JMP.search(buffer, position, limit)
        if not match:
            return
        position = match.start() + 1
        high = buffer[position + 3]
        if high in (0x00, 0xFF):
            address = (address_offset + position + 4) & 0xFFFFFF
            relative = (buffer[position] | buffer[position + 1] << 8 | buffer[position + 2] << 16) - address
            if relative & 0x800000:
                buffer[position + 3] = high ^ 0xFF
            buffer[position] = relative & 0xFF
            buffer[position + 1] = relative >> 8 & 0xFF
            buffer[position + 2] = relative >> 16 & 0xFF
        position += 4


def safe_relative(destination):
    """Map a destination such as {app}\\sub\\file.exe to a path that stays under the output."""
    parts = []
    for part in re.split(r"[\\/]+", destination):
        part = re.sub(r"[{}]", "", part)
        # Windows ignores trailing dots and spaces. Removing them also turns ".." into nothing.
        part = re.sub(r'[<>:"|?*\x00-\x1f]', "_", part).rstrip(" .")
        if not part:
            continue
        if part.split(".")[0].rstrip(" ").upper() in WINDOWS_DEVICES:
            part = "_" + part
        parts.append(part)
    return os.path.join(*parts) if parts else "unnamed"


def unique_path(path, digest, taken):
    """Keep variants that share a destination, such as one per language, under numbered names."""
    candidate = path
    number = 1
    while taken.get(os.path.normcase(candidate), digest) != digest:
        number += 1
        candidate = f"{path}~{number}"
    taken[os.path.normcase(candidate)] = digest
    return candidate


def new_digest(name):
    """Return a hash object, or None for XXH128 when xxhash isn't installed."""
    if name == "xxh128":
        return xxhash.xxh128() if xxhash else None
    return hashlib.new(name)


def extract_location(stream, location, targets):
    """Copy one file out of the chunk, restoring the bytes, and verify its hash when it can."""
    digest = new_digest(location.hash_name)
    os.makedirs(os.path.dirname(targets[0]), exist_ok=True)
    # mkstemp doesn't follow a link left in the output, which a fixed name would.
    descriptor, partial = tempfile.mkstemp(dir=os.path.dirname(targets[0]), suffix=".part")
    left = location.size
    address = 0
    try:
        with os.fdopen(descriptor, "wb") as output:
            while left > 0:
                buffer = stream.read(min(left, FILTER_BLOCK))
                if location.call_filter:
                    undo_call_filter(buffer, address)
                    address = (address + len(buffer)) & 0xFFFFFFFF
                if digest:
                    digest.update(buffer)
                output.write(buffer)
                left -= len(buffer)
        if digest and digest.digest() != location.digest:
            return False
        os.chmod(partial, 0o644)
        os.replace(partial, targets[0])
    finally:
        if os.path.exists(partial):
            os.remove(partial)
    for extra in targets[1:]:
        os.makedirs(os.path.dirname(extra), exist_ok=True)
        shutil.copyfile(targets[0], extra)
    return True


def escape(text):
    """Keep names from the installer from reaching the terminal as control sequences."""
    out = []
    for char in text:
        if char == "\\" or char.isprintable():
            out.append(char)
        elif char == "\t":
            out.append("\\t")
        elif char == "\n":
            out.append("\\n")
        elif char == "\r":
            out.append("\\r")
        else:
            out.append(f"\\u{ord(char):04x}" if ord(char) < 0x10000 else f"\\U{ord(char):08x}")
    return "".join(out)


def fields(*pairs):
    return "\t".join(f"{name}={escape(value)}" for name, value in pairs if value)


def conditions(strings, components, tasks, languages, check):
    return [("components", strings[components]), ("tasks", strings[tasks]), ("languages", strings[languages]),
            ("check", strings[check])]


def command_info(installer, args):
    header = installer.header.strings
    locations = installer.locations
    print(f"format\t{installer.version}")
    if installer.modified:
        print("build\tmodified, XXH32 checksums instead of CRC32")
    print(f"app\t{escape(header[APP_NAME])}")
    print(f"version\t{escape(header[APP_VERSION])}")
    print(f"publisher\t{escape(header[APP_PUBLISHER])}")
    print(f"app id\t{escape(header[APP_ID])}")
    print(f"compression\t{installer.compression}")
    print(f"encryption\t{installer.encryption}")
    print(f"embedded data\t{'yes' if installer.offset1 else 'no, it is in setup-1.bin'}")
    print(f"languages\t{', '.join(escape(language.strings[0]) for language in installer.languages)}")
    print(f"files\t{installer.counts['files']} entries, {len(locations)} stored, "
          f"{sum(location.size for location in locations)} bytes")
    print(f"chunks\t{len({(location.first_slice, location.start_offset) for location in locations})}")
    print(f"run\t{installer.counts['run']} on install, {installer.counts['uninstall_run']} on uninstall")
    print(f"registry\t{installer.counts['registry']}")
    print(f"code\t{len(installer.code)} bytes")


def command_list(installer, args):
    for entry in installer.files:
        strings = entry.strings
        index = installer.file_location(entry)
        extra = fields(*conditions(strings, FILE_COMPONENTS, FILE_TASKS, FILE_LANGUAGES, FILE_CHECK))
        if index >= 0:
            location = installer.locations[index]
            first = f"{location.size}\t{location.hash_name}:{location.digest.hex()}"
        elif entry.fixed[-1] == FILE_UNINSTALLER:
            first = "-\tuninstaller"
        else:
            first = "-\texternal"
            extra = "\t".join(item for item in (fields(("source", strings[FILE_SOURCE])), extra) if item)
        print("\t".join(item for item in (first, escape(strings[FILE_DEST]), extra) if item))


def print_section(title, lines):
    if lines:
        print(f"[{title}]")
        for line in lines:
            print(line)
        print()


def run_lines(installer, entries):
    lines = []
    offset = 26 if installer.layout.run_fixed == 28 else 25
    for entry in entries:
        strings = entry.strings
        options = entry.fixed[offset]
        flags = []
        if options & RUN_SHELLEXEC:
            flags.append("shellexec")
        if options & RUN_POSTINSTALL:
            flags.append("postinstall")
        if entry.fixed[24] == RUN_NOWAIT:
            flags.append("nowait")
        lines.append(fields(("name", strings[RUN_NAME]), ("params", strings[RUN_PARAMS]),
                            ("workingdir", strings[RUN_DIR]), ("verb", strings[RUN_VERB]),
                            ("flags", " ".join(flags)),
                            *conditions(strings, RUN_COMPONENTS, RUN_TASKS, RUN_LANGUAGES, RUN_CHECK)))
    return lines


def registry_lines(installer):
    lines = []
    for entry in installer.registry:
        strings = entry.strings
        root = struct.unpack_from("<I", entry.fixed, 20)[0]
        kind = entry.fixed[26]
        lines.append(fields(("root", REGISTRY_ROOTS.get(root, f"{root:#x}")), ("subkey", strings[REG_SUBKEY]),
                            ("name", strings[REG_VALUE_NAME]),
                            ("type", REG_TYPES[kind] if kind < len(REG_TYPES) else str(kind)),
                            ("data", strings[REG_VALUE_DATA]),
                            *conditions(strings, REG_COMPONENTS, REG_TASKS, REG_LANGUAGES, REG_CHECK)))
    return lines


def delete_lines(entries):
    lines = []
    for entry in entries:
        kind = entry.fixed[20]
        lines.append(fields(("name", entry.strings[0]),
                            ("type", DELETE_TYPES[kind] if kind < len(DELETE_TYPES) else str(kind))))
    return lines


def command_actions(installer, args):
    print_section("Run", run_lines(installer, installer.run))
    print_section("UninstallRun", run_lines(installer, installer.uninstall_run))
    print_section("Registry", registry_lines(installer))
    print_section("Ini", [fields(("file", e.strings[0]), ("section", e.strings[1]), ("key", e.strings[2]),
                                 ("value", e.strings[3])) for e in installer.ini])
    print_section("InstallDelete", delete_lines(installer.install_delete))
    print_section("UninstallDelete", delete_lines(installer.uninstall_delete))
    print_section("Icons", [fields(("name", e.strings[0]), ("target", e.strings[1]), ("params", e.strings[2]))
                            for e in installer.icons])
    registered = []
    external = []
    for entry in installer.files:
        strings = entry.strings
        if installer.file_options(entry) & FILE_REGSERVER:
            registered.append(fields(("dest", strings[FILE_DEST])))
        if installer.file_location(entry) < 0 and entry.fixed[-1] != FILE_UNINSTALLER:
            external.append(fields(("source", strings[FILE_SOURCE]), ("dest", strings[FILE_DEST])))
    print_section("RegisterServer", registered)
    print_section("External", external)


PROCEDURE = re.compile(rb"(?<![A-Za-z0-9_])[A-Z_][A-Z0-9_]{3,}(?![a-z0-9_])")
IMPORT = re.compile(rb"(?:dll|class|intf):[\x20-\x7e]{1,200}(?:\x00[\x20-\x7e]{1,200})?")
ASCII_TEXT = re.compile(rb"[\x20-\x7e]{6,}")
WIDE_TEXT = re.compile(rb"(?:[\x20-\x7e]\x00){4,}")


def command_code(installer, args):
    code = installer.code
    if not code:
        print("no [Code] section")
        return
    if args.dump:
        with open(args.dump, "wb") as output:
            output.write(code)
    print(f"bytes\t{len(code)}")
    if code[:4] != b"IFPS":
        print("not a compiled script, nothing to scan")
        return
    print_section("Imports", sorted({escape(match.replace(b"\0", b" ").decode("latin1"))
                                     for match in IMPORT.findall(code)}))
    print_section("Names", sorted({match.decode("latin1") for match in PROCEDURE.findall(code)}))
    texts = {match.decode("latin1") for match in ASCII_TEXT.findall(code)}
    texts |= {match.decode("utf-16-le") for match in WIDE_TEXT.findall(code)}
    print_section("Strings", sorted(escape(text) for text in texts
                                    if re.search(r"[a-z.\\/:]", text) and not IMPORT.match(text.encode("latin1", "replace"))))


IFPS_ID = b"IFPS"
IFPS_PROC_EXTERNAL, IFPS_PROC_EXPORTED, IFPS_PROC_ATTRIBUTES = 1, 2, 4
IFPS_EXPORTED_TYPE = 0x80
IFPS_LOCAL_BASE = 0x60000000
IFPS_TYPE_NAMES = {0: "return", 1: "u8", 2: "s8", 3: "u16", 4: "s16", 5: "u32", 6: "s32", 7: "single", 8: "double",
                   9: "extended", 10: "string", 11: "record", 12: "array", 13: "pointer", 14: "pchar", 15: "resource",
                   16: "variant", 17: "s64", 18: "char", 19: "widestring", 20: "widechar", 21: "procptr",
                   22: "staticarray", 23: "set", 24: "currency", 25: "class", 26: "interface", 27: "notification",
                   28: "unicodestring"}
IFPS_CALC = ("+", "-", "*", "/", "mod", "shl", "shr", "and", "or", "xor")
IFPS_COMPARE = (">=", "<=", ">", "<", "<>", "=", "in", "is")
IFPS_DECLARATION = re.compile(rb"(?:dll|class|intf):[\x20-\x7e]{1,200}(?:\x00[\x20-\x7e]{1,200})?")


class Script:
    """A compiled PascalScript, the bytecode of the [Code] section."""

    def __init__(self, code):
        self.reader = reader = Reader(code)
        if reader.take(4) != IFPS_ID:
            raise InnoError("not a compiled script")
        self.build = reader.u32()
        counts = [reader.u32() for _ in range(3)]
        self.main = reader.u32()
        reader.u32()  # size of the import table
        if any(count > len(code) for count in counts):
            raise InnoError("entry counts make no sense for a compiled script")
        self.types = [self._type() for _ in range(counts[0])]
        self.procs = [self._proc() for _ in range(counts[1])]
        self.variables = [self._variable() for _ in range(counts[2])]

    def _name(self):
        return self.reader.take(self.reader.u32()).decode("latin1")

    def _attributes(self):
        if self.build < 21:
            return
        for _ in range(self.reader.u32()):
            self._name()
            for _ in range(self.reader.u32()):
                self._immediate(self.reader.u32())

    def _type(self):
        reader = self.reader
        raw = reader.u8()
        base = raw & ~IFPS_EXPORTED_TYPE
        detail = ""
        if base in (21, 25):
            detail = self._name()
        elif base == 26:
            reader.take(16)
        elif base == 23:
            detail = str(reader.u32())
        elif base == 22:
            detail = " ".join(str(reader.u32()) for _ in range(3 if self.build >= 21 else 2))
        elif base == 12:
            detail = str(reader.u32())
        elif base == 11:
            detail = " ".join(str(reader.u32()) for _ in range(reader.u32()))
        name = self._name() if raw & IFPS_EXPORTED_TYPE else ""
        self._attributes()
        return base, name, detail

    def _proc(self):
        reader = self.reader
        flags = reader.u8()
        name, declaration, offset, size = "", b"", None, None
        if flags & IFPS_PROC_EXTERNAL:
            name = reader.take(reader.u8()).decode("latin1")
            if flags & IFPS_PROC_EXPORTED:
                declaration = reader.take(reader.u32())
        else:
            offset, size = reader.u32(), reader.u32()
            if flags & IFPS_PROC_EXPORTED:
                name = self._name()
                declaration = reader.take(reader.u32())
        if flags & IFPS_PROC_ATTRIBUTES:
            self._attributes()
        return bool(flags & IFPS_PROC_EXTERNAL), name, declaration, offset, size

    def _variable(self):
        kind = self.reader.u32()
        flags = self.reader.u8()
        return kind, self._name() if flags & 1 else ""

    def proc_name(self, index):
        if index >= len(self.procs):
            raise InnoError(f"call to procedure {index}, which doesn't exist")
        external, name, declaration, _, _ = self.procs[index]
        if external and not name:
            match = IFPS_DECLARATION.match(declaration)
            if match:
                return escape(match.group().replace(b"\0", b" ").decode("latin1"))
        return escape(name) or f"proc_{index}"

    def _immediate(self, type_index):
        if type_index >= len(self.types):
            raise InnoError(f"constant of type {type_index}, which doesn't exist")
        reader = self.reader
        base, _, detail = self.types[type_index]
        if base in (1, 2):
            return str(reader.u8())
        if base == 18:
            return repr(escape(chr(reader.u8())))
        if base in (3, 4):
            return str(struct.unpack("<H", reader.take(2))[0])
        if base == 20:
            return repr(escape(reader.take(2).decode("utf-16-le", "replace")))
        if base in (5, 6):
            return str(reader.i32())
        if base == 17:
            return str(struct.unpack("<q", reader.take(8))[0])
        if base == 7:
            return str(struct.unpack("<f", reader.take(4))[0])
        if base in (8, 24):
            return str(struct.unpack("<d", reader.take(8))[0])
        if base == 9:
            return reader.take(10).hex()
        if base in (10, 14):
            return f'"{escape(reader.take(reader.u32()).decode("latin1"))}"'
        if base in (19, 28):
            return f'"{escape(reader.take(reader.u32() * 2).decode("utf-16-le", "replace"))}"'
        if base == 23:
            return reader.take((int(detail) + 7) // 8).hex()
        if base == 21:
            return f"proc_{reader.u32()}"
        raise InnoError(f"constant of type {IFPS_TYPE_NAMES.get(base, base)} isn't known")

    @staticmethod
    def _variable_name(number):
        if number < 0x40000000:
            return f"G{number}"
        return f"L{number - IFPS_LOCAL_BASE}"

    def _operand(self):
        reader = self.reader
        kind = reader.u8()
        if kind == 0:
            return self._variable_name(reader.u32())
        if kind == 1:
            return "#" + self._immediate(reader.u32())
        if kind == 2:
            base = reader.u32()
            return f"{self._variable_name(base)}[{reader.u32()}]"
        if kind == 3:
            base = reader.u32()
            return f"{self._variable_name(base)}[{self._variable_name(reader.u32())}]"
        raise InnoError(f"operand of kind {kind} isn't known")

    def _type_name(self, index):
        if index >= len(self.types):
            return f"type_{index}"
        base, name, _ = self.types[index]
        return escape(name) or IFPS_TYPE_NAMES.get(base, str(base))

    def _instruction(self):
        """Decode the instruction at the reader and return its text, which is empty for a NOP."""
        reader = self.reader
        op = reader.u8()
        operand = self._operand
        if op == 0:
            target = operand()
            return f"{target} := {operand()}"
        if op == 1:
            kind = reader.u8()
            target = operand()
            return f"{target} {self._table(IFPS_CALC, kind)}= {operand()}"
        if op in (2, 3):
            return f"{'push' if op == 2 else 'pushvar'} {operand()}"
        if op == 4:
            return "pop"
        if op == 5:
            return f"call {self.proc_name(reader.u32())}"
        if op == 6:
            jump = reader.i32()
            return f"goto {reader.pos + jump:#x}"
        if op in (7, 8):
            jump = reader.i32()
            condition = operand()
            return f"{'if' if op == 7 else 'ifnot'} {condition} goto {reader.pos + jump:#x}"
        if op == 9:
            return "ret"
        if op == 10:
            target = operand()
            return f"settype {target} {self._type_name(reader.u32())}"
        if op == 11:
            return f"pushtype {self._type_name(reader.u32())}"
        if op == 12:
            kind = reader.u8()
            target = operand()
            left = operand()
            return f"{target} := {left} {self._table(IFPS_COMPARE, kind)} {operand()}"
        if op == 13:
            return f"callvar {operand()}"
        if op == 14:
            target = operand()
            return f"setpointer {target} {operand()}"
        if op in (15, 16, 21, 23, 24):
            return f"{ {15: 'boolnot', 16: 'negate', 21: 'intnot', 23: 'inc', 24: 'dec'}[op]} {operand()}"
        if op == 17:
            target = operand()
            return f"setflag {target} {reader.u8()}"
        if op == 18:
            jump = reader.i32()
            return f"flaggoto {reader.pos + jump:#x}"
        if op == 19:
            return "pushexception " + " ".join(str(reader.u32()) for _ in range(4))
        if op == 20:
            return f"popexception {reader.u8()}"
        if op == 22:
            target = operand()
            return f"setcopypointer {target} {operand()}"
        if op == 255:
            return ""
        raise InnoError(f"opcode {op} isn't known")

    @staticmethod
    def _table(names, index):
        return names[index] if index < len(names) else f"op_{index}"

    def disassemble(self, index):
        """Yield the lines of a procedure and stop with a note at the first bad instruction."""
        _, _, _, offset, size = self.procs[index]
        reader = self.reader
        reader.pos = offset
        end = offset + size
        while reader.pos < end:
            start = reader.pos
            try:
                line = self._instruction()
            except InnoError as error:
                yield f"{start:#06x}\tcan't decode further: {error}"
                return
            if line:
                yield f"{start:#06x}\t{line}"


def command_disasm(installer, args):
    code = installer.code
    if not code:
        print("no [Code] section")
        return 0
    if code[:4] != IFPS_ID:
        raise InnoError("not a compiled script, nothing to disassemble")
    script = Script(code)
    print(f"build\t{script.build}")
    print(f"procedures\t{len(script.procs)}, main is {script.proc_name(script.main) if script.procs else 'absent'}")
    # This list is what the script can reach. Anything absent from it can't run.
    print_section("External", [f"{index}\t{script.proc_name(index)}" for index, proc in enumerate(script.procs) if proc[0]])
    print_section("Variables", [f"G{index}\t{script._type_name(kind)}\t{escape(name)}".rstrip("\t")
                                for index, (kind, name) in enumerate(script.variables)])
    found = False
    for index, proc in enumerate(script.procs):
        if proc[0] or (args.proc and proc[1].lower() != args.proc.lower()):
            continue
        found = True
        print(f"[Procedure {index}]\t{script.proc_name(index)}")
        for line in script.disassemble(index):
            print(line)
        print()
    if args.proc and not found:
        raise InnoError(f"no procedure named {escape(args.proc)}")
    return 0


def command_engine(installer, args):
    table = installer.table
    data, _ = read_block(installer.view, table.engine_offset, installer.checksum)
    engine = bytearray(data)
    # The whole file goes through the filter at once, unlike the 64 KiB blocks of a data file.
    undo_call_filter(engine, 0)
    verified = installer.checksum(engine) == table.engine_check
    print(f"size\t{len(engine)} of {table.engine_size} expected")
    print(f"sha256\t{hashlib.sha256(engine).hexdigest()}")
    print(f"checksum\t{'matches' if verified else 'differs'}")
    if not verified or len(engine) != table.engine_size:
        raise InnoError("the engine doesn't match the checksum in the offset table, nothing was written")
    with open(args.out, "wb") as output:
        output.write(engine)
    return 0


def command_extract(installer, args):
    if not installer.offset1:
        raise InnoError("the data isn't inside the EXE, this needs setup-1.bin")
    output_root = os.path.realpath(args.dir)
    os.makedirs(output_root, exist_ok=True)
    wanted = {}
    taken = {}
    for entry in installer.files:
        index = installer.file_location(entry)
        destination = entry.strings[FILE_DEST]
        if index < 0:
            continue
        if args.only and not any(fnmatch.fnmatch(destination.lower(), pattern.lower()) for pattern in args.only):
            continue
        location = installer.locations[index]
        path = unique_path(os.path.join(output_root, safe_relative(destination)), location.digest, taken)
        if os.path.commonpath((output_root, os.path.realpath(path))) != output_root:
            raise InnoError(f"destination leaves the output directory: {escape(destination)}")
        if path not in wanted.setdefault(index, []):
            wanted[index].append(path)
    needed = sum(installer.locations[index].size for index in wanted)
    available = shutil.disk_usage(output_root).free
    if needed > available:
        raise InnoError(f"the files claim {needed} bytes and {available} are free")
    chunks = {}
    for index in wanted:
        location = installer.locations[index]
        chunks.setdefault((location.first_slice, location.start_offset), []).append(location)
    written = skipped = failed = unverified = 0
    for key in sorted(chunks):
        members = sorted(chunks[key], key=lambda location: location.chunk_suboffset)
        encrypted = members[0].encrypted
        if encrypted and installer.key is None:
            skipped += len(members)
            for location in members:
                print(f"encrypted, skipped\t{escape(wanted[location.index][0])}", file=sys.stderr)
            continue
        total = max(location.chunk_suboffset + location.size for location in members)
        base = members[0]._replace(start_offset=installer.offset1 + key[1])

        def open_stream():
            decrypt = installer.chunk_cipher(*key) if encrypted else None
            return ChunkStream(installer.view, base, installer.compression, total, decrypt)

        stream = open_stream()
        position = 0
        for location in members:
            if location.chunk_suboffset < position:
                stream = open_stream()
                position = 0
            while position < location.chunk_suboffset:
                position += len(stream.read(min(location.chunk_suboffset - position, 1 << 20)))
            if extract_location(stream, location, wanted[location.index]):
                written += len(wanted[location.index])
                if new_digest(location.hash_name) is None:
                    unverified += len(wanted[location.index])
            else:
                failed += 1
                print(f"hash mismatch, removed\t{escape(wanted[location.index][0])}", file=sys.stderr)
            position += location.size
    note = f", {unverified} not verified, XXH128 needs the xxhash module" if unverified else ""
    print(f"{written} files written to {escape(output_root)}, {skipped} skipped, {failed} failed{note}")
    return 1 if failed or skipped or unverified else 0


def main():
    parser = argparse.ArgumentParser(description="Read Inno Setup 6.0 to 7.1 installers without running them.")
    commands = parser.add_subparsers(dest="command", required=True)
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--password", help="decrypt formats 6.4 and newer with this password")
    for name, handler, help_text in (("info", command_info, "format, application and storage"),
                                     ("list", command_list, "files with size, hash and destination"),
                                     ("actions", command_actions, "what the installer does besides copying files")):
        command = commands.add_parser(name, help=help_text, parents=[common])
        command.add_argument("file")
        command.set_defaults(handler=handler)
    command = commands.add_parser("code", help="names and strings in the compiled [Code] script", parents=[common])
    command.add_argument("file")
    command.add_argument("--dump", help="also write the compiled script to this file")
    command.set_defaults(handler=command_code)
    command = commands.add_parser("disasm", help="disassemble the compiled [Code] script", parents=[common])
    command.add_argument("file")
    command.add_argument("--proc", help="only this procedure, any case")
    command.set_defaults(handler=command_disasm)
    command = commands.add_parser("engine", help="write the setup engine stored in the installer", parents=[common])
    command.add_argument("file")
    command.add_argument("out")
    command.set_defaults(handler=command_engine)
    command = commands.add_parser("extract", help="write the embedded files and verify their hashes", parents=[common])
    command.add_argument("file")
    command.add_argument("dir")
    command.add_argument("--only", action="append", help="glob on the destination, any case, can repeat")
    command.set_defaults(handler=command_extract)
    args = parser.parse_args()
    try:
        with open(args.file, "rb") as source:
            if os.fstat(source.fileno()).st_size == 0:
                raise InnoError("empty file")
            with mmap.mmap(source.fileno(), 0, access=mmap.ACCESS_READ) as view:
                return args.handler(Installer(view, args.password), args) or 0
    except MemoryError:
        print("inno-unpack: not enough memory for this installer", file=sys.stderr)
        return 2
    except (InnoError, lzma.LZMAError, zlib.error, OSError) as error:
        print(f"inno-unpack: {error}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
